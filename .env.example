# Institutional Quantitative Trading Platform Environment Configuration

# System Environment
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=institutional-quant-secret-key-change-in-production-256bit
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000

# Database & Cache
# Development uses SQLite; Production uses PostgreSQL
DATABASE_URL=sqlite:///./quant_platform.db
REDIS_URL=redis://localhost:6379/0

# Master Live Trading Safety Gate (Hard default is False)
LIVE_TRADING_ENABLED=False
DEFAULT_BROKER=MOCK_BROKER

# Deterministic Risk Limits (Hard safety defaults)
DEFAULT_RISK_PER_TRADE=0.0025
MAX_DAILY_LOSS=0.01
MAX_DRAWDOWN=0.10
MAX_OPEN_POSITIONS=3
MIN_RISK_REWARD=2.0
MAX_SPREAD_PIPS=3.0
MAX_CONSECUTIVE_LOSSES=3
MAX_CURRENCY_CONCENTRATION=2
MAX_NOTIONAL_EXPOSURE=50000.0

# Quality Gate & AutoTrader
AUTOTRADER_SCAN_INTERVAL_SECONDS=5
QUALITY_MODE=True
COOLDOWN_STANDARD_MINUTES=15
COOLDOWN_POST_LOSS_MINUTES=30
BREAK_EVEN_TRIGGER_R=1.0
BREAK_EVEN_OFFSET_PIPS=1.0

# External Market Data Providers
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Broker Credentials (Encrypted at rest with AES-256)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=True

OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

DERIV_APP_ID=1089
DERIV_API_TOKEN=

MT5_HOST=127.0.0.1
MT5_PORT=18812
